%% Relationships (multiplicities)
User "1" -- "0..*" ApiKey : "apiKeys"
User "1" -- "0..*" Cart : "carts"
User "1" -- "0..*" Payments : "payments"
User "1" -- "0..*" CouponUsage : "couponUsages"
User "1" -- "0..*" OTP : "otps (by email)"

Product *-- Product_ColorOption : "colorOptions"
Product *-- Product_Review : "reviews"
Product "*" -- "1" Category : "category"
Product "*" -- "1" Brand : "brand (logical link)"
ProductType "1" -- "0..*" Product : "products (by code logical link)"
ProductType *-- ProductType_Attribute : "attributesTemplate"

Cart *-- Cart_ProductItem : "productItems"
Payments *-- Payments_Product : "products"
Payments *-- Payments_ProductReview : "productReviews"
Payments *-- Payments_ContactMessage : "contactMessages"

Payments "*" -- "1" Coupon : "coupon"
Cart "*" -- "1" Coupon : "coupon"
Coupon "1" -- "0..*" CouponUsage : "usages"

FlashSale "*" -- "1" Product : "product"

